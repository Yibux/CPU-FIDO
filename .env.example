# Skopiuj jako .env. Bez pliku .env działają wartości domyślne dla http://localhost:8080.

# --- Relying Party ---
# Lokalnie (Windows Hello, bez HTTPS):
RP_ID=localhost
ORIGIN=http://localhost:8080
# Za tunelem (telefony) – sama domena w RP_ID, pełny adres z https:// w ORIGIN:
# RP_ID=przykladowa-nazwa.trycloudflare.com
# ORIGIN=https://przykladowa-nazwa.trycloudflare.com
RP_NAME=FIDO2 Passkeys Demo

# --- Sesje ---
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=zmien-mnie

# --- PostgreSQL ---
POSTGRES_USER=fido
POSTGRES_PASSWORD=fido
POSTGRES_DB=fido
